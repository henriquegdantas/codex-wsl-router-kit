# Copy to config.env (git-ignored) only if auto-detection gets something wrong.
# Values are read by scripts/env.sh inside WSL.

# Your Windows user folder as a WSL path. Auto-detected via cmd.exe %USERPROFILE%.
#WIN_HOME=/mnt/c/Users/yourname

# Codex home, if you moved it away from %USERPROFILE%\.codex
#CODEX_HOME_OVERRIDE=/mnt/c/Users/yourname/.codex

# Your WSL distro name (defaults to the distro running the script).
# The .cmd launchers use your default distro; to pick another one set the Windows
# environment variable CODEX_WSL_DISTRO (e.g. setx CODEX_WSL_DISTRO Ubuntu-24.04).
#WSL_DISTRO=Ubuntu
